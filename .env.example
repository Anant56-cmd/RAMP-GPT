# Database Credentials (MySQL)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rag

# Primary Engine: Groq Cloud (Free: 14,400 requests/day from console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Secondary Backup: Google Gemini (Free tier from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Offline Fallback: Local Ollama Model
OLLAMA_MODEL=qwen2.5-coder:7b
